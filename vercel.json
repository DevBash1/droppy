{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "functions": {
        "api/index.js": {
            "includeFiles": "node_modules/{puppeteer-extra-plugin-*/**,@sparticuz/chromium/bin/**}"
        }
    },
    "rewrites": [
        { "source": "/api/(.*)", "destination": "/api" },
        { "source": "/oauth/(.*)", "destination": "/api" },
        { "source": "/webhooks", "destination": "/api" },
        { "source": "/(.*)", "destination": "/index.html" }
    ]
}
